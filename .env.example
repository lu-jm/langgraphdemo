# ===== 应用 =====
APP_NAME="LangGraph A2UI Agent"
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 多个来源用英文逗号分隔；生产环境不要使用 *
CORS_ORIGINS=*

# ===== 大模型 =====
# openai（默认，走 OpenAI 兼容接口，默认指向 DeepSeek）或 zhipu
LLM_PROVIDER=openai

# 智谱 GLM
ZHIPUAI_API_KEY=1234
ZHIPUAI_MODEL=glm-4.7
ZHIPUAI_TEMPERATURE=0.3

# OpenAI / 兼容接口（LLM_PROVIDER=openai 时生效）
# 默认使用 DeepSeek，Key 只放在 .env，不要提交到仓库
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_TEMPERATURE=0.3
# auto：DeepSeek 域名下自动关闭思考模式；其他兼容接口不发送该字段
OPENAI_THINKING_MODE=auto

# ===== Agent =====
AGENT_RECURSION_LIMIT=30
AGENT_PARALLEL_TOOL_CALLS=false
ENABLE_DYNAMIC_A2UI=true

# 是否在 AG-UI SSE 中输出 LangGraph 原始事件（调试用，体积大）
AGUI_EMIT_RAW_EVENTS=false
AGUI_EMIT_SUBAGENT_EVENTS=false

# ===== A2UI =====
A2UI_CATALOG_ID=https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json
A2UI_MAX_SURFACES_PER_THREAD=50
A2UI_MAX_ACTIONS_PER_THREAD=100

# ===== 会话持久化 =====
# memory（默认，重启丢失）或 sqlite
CHECKPOINT_BACKEND=memory
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
